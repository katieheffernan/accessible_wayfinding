# Your Anthropic API key. Get one at https://console.anthropic.com/settings/keys
# This is read server-side only (by the /api/analyze function) and is never
# sent to the browser. Copy this file to `.env` and fill in your key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model used to read the photo.
# Default is claude-opus-5. A smaller model responds faster, which matters
# when someone is standing on a sidewalk waiting for guidance:
#   claude-sonnet-5   — faster, still strong at vision
#   claude-haiku-4-5  — fastest, cheapest
# ANTHROPIC_MODEL=claude-opus-5

# Optional: how hard the model thinks before answering.
# low = fastest replies (the default here), high = most careful reasoning.
# ANTHROPIC_EFFORT=low
